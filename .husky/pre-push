
# Runs the Maestro "critical paths" smoke flow (~30s, no quest-completion wait)
# before push, so a broken core flow can't quietly slip into a PR.
#
# Behavior:
#   - No `maestro` CLI or no connected device/emulator -> skip (warn only).
#     We can't force every contributor's machine into a testable state from
#     a git hook, so an unready environment must not block the push.
#   - Device present and app already running/authenticated -> run the smoke
#     flow for real; a genuine failure BLOCKS the push.
#   - Bypass for a single push: `git push --no-verify`.

if ! command -v maestro >/dev/null 2>&1; then
  echo "⚠️  Maestro not installed, skipping pre-push e2e smoke test."
  echo "   Install: curl -Ls 'https://get.maestro.mobile.dev' | bash"
  exit 0
fi

DEVICE_CONNECTED=0
if command -v adb >/dev/null 2>&1 && [ -n "$(adb devices | awk 'NR>1 && $2=="device" {print}')" ]; then
  DEVICE_CONNECTED=1
elif command -v xcrun >/dev/null 2>&1 && xcrun simctl list devices booted | grep -q "Booted"; then
  DEVICE_CONNECTED=1
fi

if [ "$DEVICE_CONNECTED" -eq 0 ]; then
  echo "⚠️  No connected device/emulator found, skipping pre-push e2e smoke test."
  echo "   Boot a simulator/emulator with the app running to get this check."
  exit 0
fi

echo "🧪 Running Maestro critical-paths smoke test before push..."
maestro test .maestro/flows/05-regression/critical-paths.yaml
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "❌ Critical-paths smoke test failed — push blocked."
  echo "   Fix the regression, or bypass once with: git push --no-verify"
  exit $EXIT_CODE
fi

echo "✅ Critical-paths smoke test passed."
exit 0
