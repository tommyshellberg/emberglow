diff --git a/android/build.gradle b/android/build.gradle
index a5edbb79734e1c42f3c95da467838802c743e7b2..6a9da2c4ddab581608ac998632fa843a765c81fe 100644
--- a/android/build.gradle
+++ b/android/build.gradle
@@ -21,4 +21,15 @@ android {
 dependencies {
     //noinspection GradleDynamicVersion
     implementation 'com.facebook.react:react-native:+'  // From node_modules
+    // react-android's dependency constraints pin androidx.core to 1.13.1 for this module's
+    // own compile classpath (independent of the app's resolved runtime classpath, which is
+    // already >= 1.17.0 via other dependencies). NotificationCompat.ProgressStyle and
+    // Builder#setRequestPromotedOngoing require 1.17.0+, so force it here too.
+    implementation 'androidx.core:core:1.17.0'
+}
+
+configurations.all {
+    resolutionStrategy {
+        force 'androidx.core:core:1.17.0'
+    }
 }
